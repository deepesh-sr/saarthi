{
  "name": "saarthi",
  "version": "0.0.0",
  "description": "CLI for Saarthi: `npx saarthi dev`.",
  "type": "module",
  "bin": {
    "saarthi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@saarthi/core": "workspace:*",
    "@saarthi/next": "workspace:*",
    "@saarthi/viewer": "workspace:*"
  }
}
