{
  "name": "@sarathi/next",
  "version": "0.0.0",
  "description": "Next.js integration: server require-hook and dev transport for Sarathi.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@sarathi/babel": "workspace:*",
    "@sarathi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5"
  }
}
